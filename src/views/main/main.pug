//- if !isProd
//- 	div(class="env-example space" style="width:100%; height:1500px;" )
if !isProd
	div(class="env-example")
		h2( style ="color:grey") [ -- CONTENT JUST IN DEV MODE NOT PART OF THE MODULE -- ]
		h4( style ="color:grey") [ -- Usefull for replicate element of the website (menu/nav), or to add space to test lazy loading -- ]

div( id="ct_cm--" + bannerName   data-ct-module=bannerName  )
	div(class="env-example")
		h4(style ="color:burlywood") [ -- COMMON HTML -- ]
		p(style ="color:burlywood") [ -- this HTML is part of the module and if common for all the brands  -- ]
		p(style ="color:burlywood") [ -- if the HTML of the module doesn't require edits between brands, put here all the HTML  -- ]

	//- Component examples --- 

	//- BUTTON EXAMPLE WITH ANALTYCS (in dev mode on click a console log will be triggered with the data that will be sent to analytics, in build it will send the data to utag_data)
	button(class="env-example" aria-label="button example" data-tracking-id="button1" data-tracking-description="CLICK") BUTTON EXAMPLE

	//- img example, the cross origin attribute on dev is null so it's automatically removed and doesn't create CORS issues, while in build is set to anonymous.
	img(class="env-example" src="./static/images/example.png" alt="placeholder" crossorigin=crossOrigin loading="lazy")
	
	//- this part import the main.pug of the current variant in developement/build 
	!= brandHtml